{
  "name": "restringer",
  "version": "2.2.0",
  "description": "Deobfuscate Javascript with emphasis on reconstructing strings",
  "main": "index.js",
  "type": "module",
  "bin": {
    "restringer": "./bin/deobfuscate.js"
  },
  "files": [
    "index.js",
    "bin",
    "src",
    "LICENSE",
    "README.md"
  ],
  "directories": {
    "prepare": "husky install",
    "test": "tests"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "flast": "^3.1.0",
    "js-md5": "^0.9.2",
    "obfuscation-detector": "^3.0.1"
  },
  "peerDependencies": {
    "isolated-vm": "^6.2.0 || ^7.0.1"
  },
  "peerDependenciesMeta": {
    "isolated-vm": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.js --trace-warnings --no-node-snapshot",
    "test:coverage": "node --test tests/*.test.js --trace-warnings --no-node-snapshot --experimental-test-coverage",
    "test:quick": "node --test tests/*.test.js --trace-warnings --no-node-snapshot tests/functionality.test.js tests/modules.*.test.js tests/processors.test.js tests/utils.test.js tests/deobfuscation.test.js",
    "test:quick:watch": "node --test tests/*.test.js --trace-warnings --no-node-snapshot --watch tests/functionality.test.js tests/modules.*.test.js tests/processors.test.js tests/utils.test.js tests/deobfuscation.test.js",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ctrl-escp/restringer.git"
  },
  "keywords": [
    "obfuscation",
    "deobfuscate",
    "deobfuscation",
    "JS",
    "javaScript",
    "AST"
  ],
  "author": "Ben Baryo (ben.baryo@gmail.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ctrl-escp/restringer/issues"
  },
  "homepage": "https://github.com/ctrl-escp/restringer#readme",
  "devDependencies": {
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "isolated-vm": "^7.0.1"
  },
  "allowScripts": {
    "isolated-vm@6.2.0": true,
    "isolated-vm@7.0.1": true
  }
}